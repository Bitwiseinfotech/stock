<script>
  (function() {
    try {
      var filterDeprecation = function(origFn) {
        if (!origFn) return origFn;
        return function() {
          var msg = "";
          for (var i = 0; i < arguments.length; i++) {
            try {
              var it = arguments[i];
              msg += " " + (typeof it === "object" ? (it && it.message ? it.message : JSON.stringify(it)) : String(it));
            } catch (_) {
              msg += " " + String(arguments[i]);
              }
            }
            if (
              msg.indexOf("deprecated parameters") !== -1 ||
              msg.indexOf("initialization function") !== -1 ||
              msg.indexOf("pass a single object instead") !== -1 ||
              msg.indexOf("preloaded using link preload") !== -1 ||
              msg.indexOf("startTime") !== -1 ||
              msg.indexOf("reportAllChanges") !== -1
            ) {
              return;
            }
            return origFn.apply(console, arguments);
          };
        };
        if (!console.__ss_silence_patched) {
          console.__ss_silence_patched = true;
          if (console.warn) console.warn = filterDeprecation(console.warn);
          if (console.error) console.error = filterDeprecation(console.error);
          if (console.info) console.info = filterDeprecation(console.info);
        }
        window.addEventListener('error', function(e) {
          var msg = (e && e.message) ? String(e.message) : '';
          if (
            msg.indexOf('startTime') !== -1 ||
            msg.indexOf('reportAllChanges') !== -1 ||
            msg.indexOf('postMessage') !== -1
          ) {
            if (e.preventDefault) e.preventDefault();
            if (e.stopPropagation) e.stopPropagation();
            return true;
          }
        }, true);
        var oldOnError = window.onerror;
        window.onerror = function(message) {
          var str = String(message || '');
          if (
            str.indexOf('startTime') !== -1 ||
            str.indexOf('reportAllChanges') !== -1 ||
            str.indexOf('postMessage') !== -1
          ) {
            return true;
          }
          if (oldOnError) return oldOnError.apply(this, arguments);
        };
      } catch (_) {}
    })();
    window.SmartStockEmbedActive = true;
    window.SmartStockContext = {
      shop: {{ shop.permanent_domain | json }},
      productId: {{ product.id | json }},
      variantId: {{ product.selected_or_first_available_variant.id | json }}
    };
    window.SmartStockEmbedConfig = {
      shop: {{ shop.permanent_domain | json }},
      productId: {{ product.id | json }},
      variantId: {{ product.selected_or_first_available_variant.id | json }},
      moneyFormat: {{ shop.money_format | json }},
      currency: {{ shop.currency | json }}
    };
    {% if product %}
      window.SmartStockProduct = {{ product | json }};
      (function() {
        try {
          var s = {{ shop.permanent_domain | json }};
          var p = {{ product.id | json }};
          var v = {{ product.selected_or_first_available_variant.id | json }};
          if (s && p && v) {
            var url = "/apps/smart-stock/product-widget?shop=" + encodeURIComponent(s) + "&productId=" + encodeURIComponent(p) + "&variantId=" + encodeURIComponent(v);
            var localUrl = "http://localhost:5000/api/storefront/product-widget?shop=" + encodeURIComponent(s) + "&productId=" + encodeURIComponent(p) + "&variantId=" + encodeURIComponent(v);
            window.__SmartStockPreloadPromise = fetch(url, { credentials: "same-origin" })
              .then(function(r) { return r.ok ? r.json() : fetch(localUrl).then(function(lr) { return lr.ok ? lr.json() : null; }); })
              .catch(function() { return fetch(localUrl).then(function(lr) { return lr.ok ? lr.json() : null; }).catch(function() { return null; }); });
          }
        } catch (_) {}
      })();
    {% endif %}
  </script>

  {% if product %}
    <div
      id="smart-stock-high-demand"
      class="smart-stock-high-demand-embed"
      data-product-id="{{ product.id }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-shop="{{ shop.permanent_domain }}"
      data-stock="{{ product.selected_or_first_available_variant.inventory_quantity | default: 0 }}"
      style="display: none;"
      hidden
    ></div>
  {% endif %}

  <script src="{{ 'smart-stock-embed.js' | asset_url }}" defer></script>
  <link rel="stylesheet" href="{{ 'smart-stock-embed.css' | asset_url }}">

  <!-- Stockout Shield Assets -->
  <link rel="stylesheet" href="{{ 'high-demand-stockout.css' | asset_url }}">
  <script src="{{ 'high-demand-stockout.js' | asset_url }}" defer></script>

  <!-- Launch Pre-Order Assets -->
  <link rel="stylesheet" href="{{ 'launch-preorder.css' | asset_url }}">
  <script src="{{ 'launch-preorder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Smart Stock",
  "target": "head",
  "settings": []
}
{% endschema %}
